{% comment %}
  Ship-to country redirect section for Shopify Online Store 2.0 themes.

  Asks the visitor where their order should ship, resolves the country to one
  of the stores configured as blocks on this section, and sends the browser
  to that store with the country code in the URL. Countries not listed on
  any block go to the fallback store, if one is set.

  Requires these files in the theme's assets/ folder:
    jquery-1.11.1.min.js
    jquery-ui.min.js
    jquery.select-to-autocomplete.js
    jquery-ui.css

  See shopify/README.md in the repository for install steps.
{% endcomment %}

{%- liquid
  assign select_id = 'ShipToCountry-' | append: section.id
  assign status_id = 'ShipToStatus-' | append: section.id
  assign form_id = 'ShipToForm-' | append: section.id
-%}

{%- if section.settings.load_jquery -%}
  <script>window.locationSelectorPreviousJQuery = window.jQuery;</script>
  {{ 'jquery-1.11.1.min.js' | asset_url | script_tag }}
{%- endif -%}
{{ 'jquery-ui.min.js' | asset_url | script_tag }}
{{ 'jquery.select-to-autocomplete.js' | asset_url | script_tag }}
{{ 'jquery-ui.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .shipto-redirect {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__field { margin-bottom: 1rem; }
  #shopify-section-{{ section.id }} .shipto-redirect__label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__input {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    background: #fff;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__input:focus {
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__hint {
    font-size: 0.85em;
    opacity: 0.7;
    margin-top: 0.35rem;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__status {
    min-height: 1.5em;
    margin: 0 0 1rem;
    font-size: 0.95em;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__status[data-state="none"] { opacity: 0.7; }
  #shopify-section-{{ section.id }} .shipto-redirect__status[data-state="here"] { color: #1a7f37; }
  #shopify-section-{{ section.id }} .shipto-redirect__status[data-state="unavailable"] { color: #b42318; }
  #shopify-section-{{ section.id }} .shipto-redirect__remember {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.9em;
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__remember input { margin-top: 0.25em; }
  #shopify-section-{{ section.id }} .shipto-redirect__stores {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.9em;
  }
  #shopify-section-{{ section.id }} .shipto-redirect__stores a { color: inherit; }
  /* Suggestion dropdown (appended to <body>, so not scoped to the section) */
  .ui-autocomplete {
    padding: 0;
    margin: 0;
    list-style: none;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    max-height: 320px;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 1000;
  }
  .ui-autocomplete .ui-menu-item {
    display: block;
    padding: 0.5rem 0.85rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    color: #1f2933;
    cursor: pointer;
  }
  .ui-autocomplete .ui-menu-item:first-child { border-top: none; }
  .ui-autocomplete .ui-menu-item.ui-state-focus {
    background: #e6f0ff;
    color: #0b3d91;
  }
</style>

<div class="shipto-redirect">
  {%- if section.settings.heading != blank -%}
    <h2 class="shipto-redirect__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="shipto-redirect__text">{{ section.settings.text }}</div>
  {%- endif -%}

  <form id="{{ form_id }}" class="shipto-redirect__form" action="#" method="get" novalidate>
    <div class="shipto-redirect__field">
      <label class="shipto-redirect__label" for="{{ select_id }}">{{ section.settings.label | escape }}</label>
      {%- comment -%}
        The plugin hides this select and inserts a text field after it, copying
        class, placeholder and autocomplete onto the text field. The first token
        of each option's data-alternative-spellings is its ISO 3166-1 code, which
        the store blocks are matched against.
      {%- endcomment -%}
      <select
        name="country"
        id="{{ select_id }}"
        class="shipto-redirect__input"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocorrect="off"
